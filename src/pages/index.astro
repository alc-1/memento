---
import { readFileSync } from 'node:fs';
import '../styles/global.css';

const memes = JSON.parse(readFileSync('public/generated/index.json', 'utf8'));
const base = import.meta.env.BASE_URL;

// Filter chips list only values that exist in the content, and a group with a single value is not shown.
const facet = (key) => [...new Set(memes.map((m) => m[key]).filter(Boolean))].sort();
const facets = [
  { key: 'category', label: 'Category', values: facet('category') },
  { key: 'language', label: 'Language', values: facet('language') },
].filter((f) => f.values.length > 1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Memento</title>
    <meta name="description" content="There is always a time for memes. One click copies a meme, ready to paste into any chat." />
  </head>
  <body>
    <header>
      <h1><strong>Meme</strong>nto</h1>
      <p>There is always a time for memes. Yet we don't find them when we need them. They are now one-click away.</p>
    </header>

    <main>
      <form class="controls" role="search" onsubmit="return false">
        <label class="search">
          <span class="sr-only">Search memes</span>
          <input id="q" type="search" placeholder="Search memes  ( / )" autocomplete="off" />
        </label>
        {facets.map((f) => (
          <div class="chips" role="group" aria-label={f.label} data-facet={f.key}>
            <button type="button" aria-pressed="true" data-value="">All</button>
            {f.values.map((v) => (
              <button type="button" aria-pressed="false" data-value={v}>{v}</button>
            ))}
          </div>
        ))}
        <p id="status" aria-live="polite"></p>
      </form>

      <p id="none" hidden>
        No meme matches. <button type="button" id="clear">Clear search and filters</button>
      </p>

      <ul class="grid">
        {memes.map((m) => (
          <li class="card" data-slug={m.slug}>
            <button type="button" class="view" aria-label={`View larger: ${m.caption}`} aria-haspopup="dialog">
              <img src={`${base}${m.thumb}`} alt={m.caption} loading="lazy" />
            </button>
            <p class="caption">{m.caption}</p>
            <p class="credit">by {m.author}</p>
            <div class="actions">
              <button
                type="button"
                class="act copy"
                data-copy={`${base}${m.copy}`}
                data-animated={m.animated}
                aria-label={m.animated ? `Copy link to: ${m.caption}` : `Copy meme: ${m.caption}`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
                <span class="label">{m.animated ? 'Copy link' : 'Copy'}</span>
                <span class="badge" aria-live="polite"></span>
              </button>
              <a
                class="act download"
                href={`${base}${m.original}`}
                download={m.download}
                aria-label={`Download original: ${m.caption}`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11" /><path d="m7 11 5 5 5-5" /><path d="M5 20h14" /></svg>
                <span class="label">Download</span>
              </a>
              <button type="button" class="act info" aria-label={`Info: ${m.caption}`} aria-haspopup="dialog">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6" /><path d="M12 7.5v.01" /></svg>
                <span class="label">Info</span>
              </button>
            </div>
            {m.animated && <p class="hint">Animated: copy gives the link</p>}
          </li>
        ))}
      </ul>
    </main>

    <dialog id="viewer" aria-label="Meme viewer">
      <form method="dialog"><button class="close" aria-label="Close">×</button></form>
      <img id="viewer-img" alt="" />
      <p id="viewer-caption"></p>
    </dialog>

    <dialog id="info-dialog" aria-labelledby="info-title">
      <form method="dialog"><button class="close" aria-label="Close">×</button></form>
      <h2 id="info-title"></h2>
      <dl id="info-list"></dl>
    </dialog>

    <script type="application/json" id="memes-data" set:html={JSON.stringify(memes)} />

    <script>
      import '../scripts/copy.js';
      import '../scripts/viewer.js';
      import '../scripts/filter.js';
    </script>
  </body>
</html>
